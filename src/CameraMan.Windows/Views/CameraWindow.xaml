<Window x:Class="CameraMan.Windows.Views.CameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CameraMan.Windows.Views.Controls"
        xmlns:loc="clr-namespace:CameraMan.Windows.Resources"
        Title="CameraMan"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        Topmost="{Binding EffectiveAlwaysOnTop, Mode=OneWay}"
        MinWidth="120"
        MinHeight="120"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Focusable="True">
  <Grid x:Name="RootGrid" Background="Transparent">
    <controls:CameraChrome x:Name="Chrome">
      <controls:CameraChrome.Margin>
        <!-- Padding for the border/shadow, capped on small windows so the camera never disappears. -->
        <MultiBinding Converter="{StaticResource BorderPaddingToThickness}">
          <Binding Path="BorderPadding" />
          <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
          <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
        </MultiBinding>
      </controls:CameraChrome.Margin>
    </controls:CameraChrome>

    <Grid x:Name="StatusOverlay" Visibility="Collapsed" IsHitTestVisible="True">
      <Border Background="#E60B0D10"
              CornerRadius="14"
              Padding="22,18"
              MaxWidth="330"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Margin="10">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock x:Name="StatusGlyph"
                     Text="&#xE714;"
                     FontFamily="{DynamicResource IconFont}"
                     FontSize="30"
                     Foreground="#B9C0CC"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,8" />
          <TextBlock x:Name="StatusTitle"
                     FontFamily="{DynamicResource UiFont}"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="White"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="StatusDetail"
                     FontFamily="{DynamicResource UiFont}"
                     FontSize="11.5"
                     Foreground="#A3A9B4"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     Margin="0,4,0,0" />
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      Margin="0,12,0,0">
            <Button x:Name="RetryButton"
                    Content="{loc:Loc Camera_Retry}"
                    Style="{StaticResource SecondaryButton}"
                    Click="OnRetryClick" />
            <Button x:Name="OpenSettingsButton"
                    Content="{loc:Loc Camera_OpenSettings}"
                    Style="{StaticResource AccentButton}"
                    Margin="8,0,0,0"
                    Click="OnOpenSettingsClick"
                    Visibility="Collapsed" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Border x:Name="Toast"
            Background="{DynamicResource ToastBackground}"
            CornerRadius="8"
            Padding="12,8"
            Margin="12"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Visibility="{Binding ToastMessage, Converter={StaticResource NotEmptyToVisibility}}">
      <TextBlock Text="{Binding ToastMessage}"
                 FontFamily="{DynamicResource UiFont}"
                 FontSize="12"
                 Foreground="White"
                 TextTrimming="CharacterEllipsis"
                 MaxWidth="280" />
    </Border>
  </Grid>
</Window>
