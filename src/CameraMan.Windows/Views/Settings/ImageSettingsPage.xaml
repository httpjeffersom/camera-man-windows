<UserControl x:Class="CameraMan.Windows.Views.Settings.ImageSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CameraMan.Windows.Views.Controls"
             xmlns:settings="clr-namespace:CameraMan.Windows.Views.Settings"
             xmlns:loc="clr-namespace:CameraMan.Windows.Resources">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <controls:SettingsPageFrame>
    <StackPanel>
      <TextBlock Text="{loc:Loc Page_Image}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{loc:Loc Image_Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,16" />

      <controls:SettingsCard>
        <StackPanel>
          <settings:SettingsSliderRow Title="{loc:Loc Image_Brightness}"
                                      Icon="&#xE706;"
                                      IconBrush="{DynamicResource AccentImage}"
                                      Minimum="-0.5"
                                      Maximum="0.5"
                                      Step="0.05"
                                      LargeChange="0.1"
                                      Format="Signed"
                                      Value="{Binding Brightness, Mode=TwoWay}" />
          <Border Style="{StaticResource Divider}" />
          <settings:SettingsSliderRow Title="{loc:Loc Image_Contrast}"
                                      Icon="&#xE793;"
                                      IconBrush="{DynamicResource AccentImage}"
                                      Minimum="0.5"
                                      Maximum="2"
                                      Step="0.1"
                                      LargeChange="0.1"
                                      Format="Decimal"
                                      Value="{Binding Contrast, Mode=TwoWay}" />
          <Border Style="{StaticResource Divider}" />
          <settings:SettingsSliderRow Title="{loc:Loc Image_Saturation}"
                                      Icon="&#xE790;"
                                      IconBrush="{DynamicResource AccentImage}"
                                      Minimum="0"
                                      Maximum="2"
                                      Step="0.1"
                                      LargeChange="0.1"
                                      Format="Decimal"
                                      Value="{Binding Saturation, Mode=TwoWay}" />
        </StackPanel>
      </controls:SettingsCard>

      <Button Content="{loc:Loc Image_Reset}"
              HorizontalAlignment="Right"
              Margin="0,14,0,0"
              Click="OnResetClick" />
    </StackPanel>
  </controls:SettingsPageFrame>
  </ScrollViewer>
</UserControl>
