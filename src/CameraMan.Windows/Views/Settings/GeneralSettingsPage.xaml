<UserControl x:Class="CameraMan.Windows.Views.Settings.GeneralSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CameraMan.Windows.Views.Controls"
             xmlns:loc="clr-namespace:CameraMan.Windows.Resources">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <controls:SettingsPageFrame>
    <StackPanel>
      <TextBlock Text="{loc:Loc Page_General}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{loc:Loc General_Language_Desc}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,16" />

      <controls:SettingsCard>
        <controls:SettingsRow Title="{loc:Loc General_OpenAtLogin}"
                              Subtitle="{loc:Loc General_OpenAtLogin_Desc}"
                              Icon="&#xE7E8;"
                              IconBrush="#22C55E">
          <CheckBox Style="{StaticResource ToggleSwitch}"
                    IsChecked="{Binding OpenAtLogin, Mode=TwoWay}" />
        </controls:SettingsRow>
      </controls:SettingsCard>

      <TextBlock Text="{Binding StartupError}"
                 Foreground="{DynamicResource Danger}"
                 FontSize="11.5"
                 TextWrapping="Wrap"
                 Margin="4,7,0,0"
                 Visibility="{Binding StartupError, Converter={StaticResource NotEmptyToVisibility}}" />

      <controls:SettingsCard Margin="0,16,0,0">
        <StackPanel>
          <controls:SettingsRow Title="{loc:Loc General_Language}"
                                Subtitle="{loc:Loc General_Language_Desc}"
                                Icon="&#xE774;"
                                IconBrush="#3B82F6">
            <ComboBox Style="{StaticResource SettingsComboBox}"
                      Width="190"
                      AutomationProperties.Name="{loc:Loc General_Language}"
                      ItemsSource="{Binding Languages}"
                      SelectedValuePath="Code"
                      SelectedValue="{Binding Language, Mode=TwoWay}">
              <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource SettingsComboBoxItem}">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                </Style>
              </ComboBox.ItemContainerStyle>
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </controls:SettingsRow>
          <Border Style="{StaticResource Divider}" />
          <controls:SettingsRow Title="{loc:Loc General_LanguageRestart}"
                                Icon="&#xE895;"
                                IconBrush="#6B7280" />
        </StackPanel>
      </controls:SettingsCard>

      <controls:SettingsCard Margin="0,16,0,0">
        <controls:SettingsRow Title="{loc:Loc General_Restore}"
                              Subtitle="{loc:Loc General_Restore_Desc}"
                              Icon="&#xE777;"
                              IconBrush="{DynamicResource Danger}">
          <Button Content="{loc:Loc General_RestoreButton}"
                  Foreground="{DynamicResource Danger}"
                  Click="OnRestoreClick" />
        </controls:SettingsRow>
      </controls:SettingsCard>
    </StackPanel>
  </controls:SettingsPageFrame>
  </ScrollViewer>
</UserControl>
