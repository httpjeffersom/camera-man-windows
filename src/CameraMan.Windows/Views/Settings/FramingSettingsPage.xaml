<UserControl x:Class="CameraMan.Windows.Views.Settings.FramingSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CameraMan.Windows.Views.Controls"
             xmlns:settings="clr-namespace:CameraMan.Windows.Views.Settings"
             xmlns:loc="clr-namespace:CameraMan.Windows.Resources">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <controls:SettingsPageFrame>
    <StackPanel>
      <TextBlock Text="{loc:Loc Page_Framing}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{loc:Loc Framing_Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,16" />

      <controls:SettingsCard Footer="{loc:Loc Framing_Footer}">
        <StackPanel>
          <settings:SettingsSliderRow Title="{loc:Loc Framing_Horizontal}"
                                      Icon="&#xE8AB;"
                                      IconBrush="{DynamicResource AccentFraming}"
                                      Minimum="-50"
                                      Maximum="50"
                                      Step="1"
                                      Format="Percent"
                                      Value="{Binding OffsetX, Mode=TwoWay}" />
          <Border Style="{StaticResource Divider}" />
          <settings:SettingsSliderRow Title="{loc:Loc Framing_Vertical}"
                                      Icon="&#xE8AC;"
                                      IconBrush="{DynamicResource AccentFraming}"
                                      Minimum="-50"
                                      Maximum="50"
                                      Step="1"
                                      Format="Percent"
                                      Value="{Binding OffsetY, Mode=TwoWay}" />
          <Border Style="{StaticResource Divider}" />
          <settings:SettingsSliderRow Title="{loc:Loc Framing_Zoom}"
                                      Icon="&#xE8A3;"
                                      IconBrush="{DynamicResource AccentFraming}"
                                      Minimum="1"
                                      Maximum="2"
                                      Step="0.1"
                                      Format="Zoom"
                                      LargeChange="0.1"
                                      Value="{Binding Scale, Mode=TwoWay}" />
        </StackPanel>
      </controls:SettingsCard>

      <controls:SettingsCard Header="{loc:Loc Framing_Orientation}" Margin="0,16,0,0">
        <StackPanel>
          <controls:SettingsRow Title="{loc:Loc Framing_Mirror}"
                                Subtitle="{loc:Loc Framing_Mirror_Desc}"
                                Icon="&#xE8AB;"
                                IconBrush="#14B8A6">
            <CheckBox Style="{StaticResource ToggleSwitch}"
                      IsChecked="{Binding FlipHorizontal, Mode=TwoWay}" />
          </controls:SettingsRow>
          <Border Style="{StaticResource Divider}" />
          <controls:SettingsRow Title="{loc:Loc Framing_Flip}"
                                Subtitle="{loc:Loc Framing_Flip_Desc}"
                                Icon="&#xE8AC;"
                                IconBrush="#14B8A6">
            <CheckBox Style="{StaticResource ToggleSwitch}"
                      IsChecked="{Binding FlipVertical, Mode=TwoWay}" />
          </controls:SettingsRow>
        </StackPanel>
      </controls:SettingsCard>

      <Button Content="{loc:Loc Framing_Reset}"
              HorizontalAlignment="Right"
              Margin="0,14,0,0"
              Click="OnResetClick" />
    </StackPanel>
  </controls:SettingsPageFrame>
  </ScrollViewer>
</UserControl>
