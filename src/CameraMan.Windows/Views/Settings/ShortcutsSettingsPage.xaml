<UserControl x:Class="CameraMan.Windows.Views.Settings.ShortcutsSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CameraMan.Windows.Views.Controls"
             xmlns:loc="clr-namespace:CameraMan.Windows.Resources">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <controls:SettingsPageFrame>
    <StackPanel>
      <TextBlock Text="{loc:Loc Page_Shortcuts}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{loc:Loc Shortcuts_Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,16" />

      <controls:SettingsCard Header="{loc:Loc Shortcuts_Global}">
        <StackPanel>
          <controls:SettingsRow Title="{loc:Loc Shortcuts_GlobalToggle}"
                                Subtitle="{loc:Loc Shortcuts_GlobalToggle_Desc}"
                                Icon="&#xE774;"
                                IconBrush="{DynamicResource AccentShortcuts}">
            <CheckBox Style="{StaticResource ToggleSwitch}"
                      IsChecked="{Binding GlobalShortcutsEnabled, Mode=TwoWay}" />
          </controls:SettingsRow>
          <Border Style="{StaticResource Divider}" />
          <controls:SettingsRow Title="{loc:Loc Shortcuts_ShowHide}"
                                Icon="&#xE7B3;"
                                IconBrush="{DynamicResource AccentShortcuts}">
            <controls:KeyChord Keys="Ctrl|Alt|C" />
          </controls:SettingsRow>
          <Border Style="{StaticResource Divider}" />
          <controls:SettingsRow Title="{loc:Loc Shortcuts_SwitchSize}"
                                Icon="&#xE740;"
                                IconBrush="{DynamicResource AccentShortcuts}">
            <controls:KeyChord Keys="Ctrl|Alt|S" />
          </controls:SettingsRow>
        </StackPanel>
      </controls:SettingsCard>

      <TextBlock Text="{Binding GlobalHotKeyError}"
                 Foreground="{DynamicResource Danger}"
                 FontSize="11.5"
                 TextWrapping="Wrap"
                 Margin="4,7,0,0"
                 Visibility="{Binding GlobalHotKeyError, Converter={StaticResource NotEmptyToVisibility}}" />

      <controls:SettingsCard Header="{loc:Loc Shortcuts_Window}"
                             Footer="{loc:Loc Shortcuts_WindowFooter}"
                             Margin="0,16,0,0">
        <StackPanel>
          <controls:SettingsRow Title="{loc:Loc Shortcuts_Move}" Icon="&#xE8AB;" IconBrush="{DynamicResource AccentShortcuts}">
            <controls:KeyChord Keys="←|→|↑|↓" />
          </controls:SettingsRow>
          <Border Style="{StaticResource Divider}" />
          <controls:SettingsRow Title="{loc:Loc Shortcuts_Zoom}" Icon="&#xE8A3;" IconBrush="{DynamicResource AccentShortcuts}">
            <controls:KeyChord Keys="+|−" />
          </controls:SettingsRow>
          <Border Style="{StaticResource Divider}" />
          <controls:SettingsRow Title="{loc:Loc Shortcuts_ResetZoom}" Icon="&#xE71E;" IconBrush="{DynamicResource AccentShortcuts}">
            <controls:KeyChord Keys="R" />
          </controls:SettingsRow>
          <Border Style="{StaticResource Divider}" />
          <controls:SettingsRow Title="{loc:Loc Shortcuts_Mirror}" Icon="&#xE8AB;" IconBrush="{DynamicResource AccentShortcuts}">
            <controls:KeyChord Keys="/" />
          </controls:SettingsRow>
          <Border Style="{StaticResource Divider}" />
          <controls:SettingsRow Title="{loc:Loc Shortcuts_Flip}" Icon="&#xE8AC;" IconBrush="{DynamicResource AccentShortcuts}">
            <controls:KeyChord Keys="V" />
          </controls:SettingsRow>
          <Border Style="{StaticResource Divider}" />
          <controls:SettingsRow Title="{loc:Loc Shortcuts_NextShape}" Icon="&#xEA3A;" IconBrush="{DynamicResource AccentShortcuts}">
            <controls:KeyChord Keys="O" />
          </controls:SettingsRow>
          <Border Style="{StaticResource Divider}" />
          <controls:SettingsRow Title="{loc:Loc Shortcuts_NextCamera}" Icon="&#xE714;" IconBrush="{DynamicResource AccentShortcuts}">
            <controls:KeyChord Keys="Backspace" />
          </controls:SettingsRow>
          <Border Style="{StaticResource Divider}" />
          <controls:SettingsRow Title="{loc:Loc Shortcuts_SwitchSizeKey}" Icon="&#xE740;" IconBrush="{DynamicResource AccentShortcuts}">
            <controls:KeyChord Keys="Space" />
          </controls:SettingsRow>
        </StackPanel>
      </controls:SettingsCard>

      <controls:SettingsCard Header="{loc:Loc Shortcuts_Menu}" Margin="0,16,0,0">
        <StackPanel>
          <controls:SettingsRow Title="{loc:Loc Shortcuts_Settings}" Icon="&#xE713;" IconBrush="{DynamicResource AccentShortcuts}">
            <controls:KeyChord Keys="Ctrl|," />
          </controls:SettingsRow>
          <Border Style="{StaticResource Divider}" />
          <controls:SettingsRow Title="{loc:Loc Shortcuts_Quit}" Icon="&#xE7E8;" IconBrush="{DynamicResource AccentShortcuts}">
            <controls:KeyChord Keys="Ctrl|Q" />
          </controls:SettingsRow>
        </StackPanel>
      </controls:SettingsCard>
    </StackPanel>
  </controls:SettingsPageFrame>
  </ScrollViewer>
</UserControl>
