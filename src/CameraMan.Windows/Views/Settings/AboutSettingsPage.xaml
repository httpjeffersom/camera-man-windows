<UserControl x:Class="CameraMan.Windows.Views.Settings.AboutSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CameraMan.Windows.Views.Controls"
             xmlns:loc="clr-namespace:CameraMan.Windows.Resources">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <controls:SettingsPageFrame>
    <StackPanel>
      <StackPanel HorizontalAlignment="Center" Margin="0,16,0,8">
        <Image Source="/Resources/app.png" Width="88" Height="88" />
        <TextBlock Text="{loc:Loc App_Name}"
                   FontFamily="{DynamicResource UiFont}"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0" />
        <TextBlock x:Name="VersionText"
                   FontFamily="{DynamicResource UiFont}"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondary}"
                   HorizontalAlignment="Center"
                   Margin="0,2,0,0" />
        <TextBlock Text="{loc:Loc About_Description}"
                   FontFamily="{DynamicResource UiFont}"
                   FontSize="13"
                   Foreground="{DynamicResource TextSecondary}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="420"
                   Margin="0,8,0,0" />
      </StackPanel>

      <controls:SettingsCard Margin="0,18,0,0">
        <StackPanel>
          <controls:SettingsRow Title="{loc:Loc About_Source}"
                                Subtitle="{loc:Loc About_Source_Desc}"
                                Icon="&#xE943;"
                                IconBrush="{DynamicResource AccentAbout}">
            <Button Content="{loc:Loc About_Open}" Click="OnOpenSourceClick" />
          </controls:SettingsRow>
          <Border Style="{StaticResource Divider}" />
          <controls:SettingsRow Title="{loc:Loc About_Upstream}"
                                Subtitle="{loc:Loc About_Upstream_Desc}"
                                Icon="&#xE8F1;"
                                IconBrush="{DynamicResource AccentAbout}">
            <Button Content="{loc:Loc About_Open}" Click="OnOpenMacSourceClick" />
          </controls:SettingsRow>
          <Border Style="{StaticResource Divider}" />
          <controls:SettingsRow Title="{loc:Loc About_Platform}"
                                Subtitle="{loc:Loc About_PortNote}"
                                Icon="&#xE770;"
                                IconBrush="{DynamicResource AccentAbout}" />
        </StackPanel>
      </controls:SettingsCard>

      <TextBlock Text="MIT License"
                 Style="{StaticResource GroupFooter}"
                 HorizontalAlignment="Center"
                 Margin="0,18,0,0" />
    </StackPanel>
  </controls:SettingsPageFrame>
  </ScrollViewer>
</UserControl>
