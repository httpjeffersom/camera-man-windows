<Window x:Class="CameraMan.Windows.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CameraMan.Windows.Resources"
        Title="{loc:Loc Settings_Title}"
        Width="900"
        Height="640"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Background="{DynamicResource SidebarBackground}"
            BorderBrush="{DynamicResource Separator}"
            BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Margin="12,14,12,10"
                Height="32"
                CornerRadius="8"
                Background="{DynamicResource ControlBackground}"
                BorderBrush="{DynamicResource ControlBorder}"
                BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE721;"
                       FontFamily="{DynamicResource IconFont}"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondary}"
                       VerticalAlignment="Center"
                       Margin="10,0,6,0" />
            <Grid Grid.Column="1">
              <TextBox x:Name="SearchBox"
                       AutomationProperties.Name="{loc:Loc Settings_Search}"
                       Background="Transparent"
                       BorderThickness="0"
                       FontFamily="{DynamicResource UiFont}"
                       FontSize="13"
                       Foreground="{DynamicResource TextPrimary}"
                       CaretBrush="{DynamicResource TextPrimary}"
                       VerticalContentAlignment="Center"
                       TextChanged="OnSearchTextChanged"
                       PreviewKeyDown="OnSearchKeyDown" />
              <TextBlock x:Name="SearchHint"
                         Text="{loc:Loc Settings_Search}"
                         FontFamily="{DynamicResource UiFont}"
                         FontSize="13"
                         Foreground="{DynamicResource TextTertiary}"
                         VerticalAlignment="Center"
                         Margin="2,0,0,0"
                         IsHitTestVisible="False" />
            </Grid>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="NavPanel" Margin="10,0,10,12" />
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="18,8,12,14">
          <TextBlock Text="&#xE72E;"
                     FontFamily="{DynamicResource IconFont}"
                     FontSize="12"
                     Foreground="{DynamicResource Selection}"
                     VerticalAlignment="Center"
                     Margin="0,0,6,0" />
          <TextBlock Text="{loc:Loc Settings_PrivacyFooter}"
                     FontFamily="{DynamicResource UiFont}"
                     FontSize="11"
                     Foreground="{DynamicResource TextSecondary}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <ContentControl x:Name="PageHost"
                    Grid.Column="1"
                    Focusable="False" />
  </Grid>
</Window>
