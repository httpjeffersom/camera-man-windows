<UserControl x:Class="CameraMan.Windows.Views.Settings.CameraSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CameraMan.Windows.Views.Controls"
             xmlns:loc="clr-namespace:CameraMan.Windows.Resources">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <controls:SettingsPageFrame>
    <StackPanel>
      <TextBlock Text="{loc:Loc Page_Camera}" Style="{StaticResource PageTitle}" />
      <TextBlock Text="{loc:Loc Camera_Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,16" />

      <controls:SettingsCard Footer="{loc:Loc Camera_BackspaceFooter}">
        <StackPanel>
          <controls:SettingsRow Title="{loc:Loc Camera_Source}"
                                Subtitle="{Binding CameraSourceSubtitle}"
                                Icon="&#xE714;"
                                IconBrush="{DynamicResource AccentCamera}">
            <ComboBox Style="{StaticResource SettingsComboBox}"
                      Width="210"
                      AutomationProperties.Name="{loc:Loc Camera_Source}"
                      ItemsSource="{Binding VideoDevices}"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedDeviceId, Mode=TwoWay}">
              <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource SettingsComboBoxItem}">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                </Style>
              </ComboBox.ItemContainerStyle>
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </controls:SettingsRow>
          <Border Style="{StaticResource Divider}" />
          <controls:SettingsRow Title="{loc:Loc Camera_Status}"
                                Subtitle="{Binding CameraStatusText}"
                                Icon="&#xE946;"
                                IconBrush="{DynamicResource AccentCamera}">
            <StackPanel Orientation="Horizontal">
              <Button Content="{loc:Loc Camera_Refresh}" Click="OnRefreshClick" />
              <Button Content="{loc:Loc Camera_OpenPrivacy}"
                      Style="{StaticResource LinkButton}"
                      Margin="8,0,0,0"
                      Click="OnOpenPrivacyClick" />
            </StackPanel>
          </controls:SettingsRow>
          <Border Style="{StaticResource Divider}"
                  Visibility="{Binding CameraFormat, Converter={StaticResource NotEmptyToVisibility}}" />
          <controls:SettingsRow Title="{loc:Loc Camera_Format}"
                                Subtitle="{Binding CameraFormat}"
                                Icon="&#xE7C4;"
                                IconBrush="{DynamicResource AccentCamera}"
                                Visibility="{Binding CameraFormat, Converter={StaticResource NotEmptyToVisibility}}" />
        </StackPanel>
      </controls:SettingsCard>

      <controls:SettingsCard Margin="0,16,0,0">
        <controls:SettingsRow Title="{loc:Loc Camera_VideoEffectsTitle}"
                              Subtitle="{loc:Loc Camera_VideoEffectsDescription}"
                              Icon="&#xE8B9;"
                              IconBrush="#A855F7" />
      </controls:SettingsCard>

      <TextBlock Text="{loc:Loc Settings_PrivacyFooter}"
                 Style="{StaticResource GroupFooter}"
                 Margin="4,16,0,0" />
    </StackPanel>
  </controls:SettingsPageFrame>
  </ScrollViewer>
</UserControl>
