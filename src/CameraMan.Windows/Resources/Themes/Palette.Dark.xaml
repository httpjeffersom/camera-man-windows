<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <SolidColorBrush x:Key="WindowBackground" Color="#1A1B1E" />
  <SolidColorBrush x:Key="SidebarBackground" Color="#222327" />
  <SolidColorBrush x:Key="CardBackground" Color="#2A2B30" />
  <SolidColorBrush x:Key="CardStroke" Color="#3A3C43" />
  <SolidColorBrush x:Key="TextPrimary" Color="#F3F4F6" />
  <SolidColorBrush x:Key="TextSecondary" Color="#A3A9B4" />
  <SolidColorBrush x:Key="TextTertiary" Color="#858C98" />
  <SolidColorBrush x:Key="ControlBackground" Color="#303238" />
  <SolidColorBrush x:Key="ControlBorder" Color="#4B4E57" />
  <SolidColorBrush x:Key="TrackBackground" Color="#41444D" />
  <SolidColorBrush x:Key="HoverBackground" Color="#18FFFFFF" />
  <SolidColorBrush x:Key="PressedBackground" Color="#28FFFFFF" />
  <SolidColorBrush x:Key="SelectionBackground" Color="#2563EB" />
  <SolidColorBrush x:Key="Accent" Color="#4C8DFF" />
  <SolidColorBrush x:Key="AccentHover" Color="#6BA2FF" />
  <SolidColorBrush x:Key="Selection" Color="#EF4444" />
  <SolidColorBrush x:Key="Danger" Color="#F87171" />
  <SolidColorBrush x:Key="Separator" Color="#35373D" />
  <SolidColorBrush x:Key="WindowChromeBorder" Color="#35373D" />
  <SolidColorBrush x:Key="ToastBackground" Color="#E60C0D10" />
  <SolidColorBrush x:Key="ToggleKnob" Color="#FFFFFF" />

  <SolidColorBrush x:Key="AccentCamera" Color="#EF4444" />
  <SolidColorBrush x:Key="AccentShape" Color="#8B5CF6" />
  <SolidColorBrush x:Key="BlobTileFill" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="AccentFraming" Color="#38BDF8" />
  <SolidColorBrush x:Key="AccentImage" Color="#FBBF24" />
  <SolidColorBrush x:Key="AccentBorder" Color="#F472B6" />
  <SolidColorBrush x:Key="AccentWindow" Color="#34D399" />
  <SolidColorBrush x:Key="AccentGeneral" Color="#9CA3AF" />
  <SolidColorBrush x:Key="AccentShortcuts" Color="#818CF8" />
  <SolidColorBrush x:Key="AccentAbout" Color="#94A3B8" />

  <LinearGradientBrush x:Key="PreviewBackdrop" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#141418" Offset="0" />
    <GradientStop Color="#1C1C22" Offset="0.55" />
    <GradientStop Color="#33161C" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="PreviewSubject" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#64748B" Offset="0" />
    <GradientStop Color="#334155" Offset="1" />
  </LinearGradientBrush>
</ResourceDictionary>
