<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CameraMan.Windows.Views.Controls">

  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  <controls:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
  <controls:NullOrEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
  <controls:NullOrEmptyToVisibilityConverter x:Key="EmptyToVisibility" Invert="True" />
  <controls:BorderPaddingToThicknessConverter x:Key="BorderPaddingToThickness" />
  <controls:ColorToBrushConverter x:Key="ColorToBrush" />
  <controls:BorderVisibilityConverter x:Key="BorderVisibility" />
  <controls:ShapeNameConverter x:Key="ShapeName" ShortName="False" />
  <controls:ShapeNameConverter x:Key="ShapeNameShort" ShortName="True" />
  <controls:EnumEqualsConverter x:Key="EnumEquals" />
  <controls:SizeNameConverter x:Key="SizeName" />
  <controls:EdgeNameConverter x:Key="EdgeName" />

  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style x:Key="PageSubtitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <Style x:Key="GroupHeader" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="4,0,0,8" />
  </Style>

  <Style x:Key="GroupFooter" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="4,7,0,0" />
  </Style>

  <Style x:Key="Divider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="52,0,14,0" />
    <Setter Property="Background" Value="{DynamicResource Separator}" />
  </Style>

  <Style TargetType="{x:Type controls:SettingsCard}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:SettingsCard}">
          <StackPanel>
            <TextBlock x:Name="HeaderText"
                       Text="{TemplateBinding Header}"
                       Style="{StaticResource GroupHeader}" />
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardStroke}"
                    BorderThickness="1"
                    CornerRadius="12"
                    ClipToBounds="True">
              <ContentPresenter />
            </Border>
            <TextBlock x:Name="FooterText"
                       Text="{TemplateBinding Footer}"
                       Style="{StaticResource GroupFooter}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" Value="">
              <Setter TargetName="HeaderText" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Footer, RelativeSource={RelativeSource TemplatedParent}}" Value="">
              <Setter TargetName="FooterText" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type controls:SettingsRow}">
    <Setter Property="Padding" Value="14,11" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:SettingsRow}">
          <Grid Margin="{TemplateBinding Padding}" Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="IconBox"
                    Width="28"
                    Height="28"
                    Margin="0,0,12,0"
                    CornerRadius="7"
                    VerticalAlignment="Center"
                    Background="{TemplateBinding IconBrush}">
              <TextBlock Text="{TemplateBinding Icon}"
                         FontFamily="{DynamicResource IconFont}"
                         FontSize="14"
                         Foreground="White"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{TemplateBinding Title}"
                         FontWeight="SemiBold"
                         FontSize="13"
                         TextWrapping="Wrap" />
              <TextBlock x:Name="SubtitleText"
                         Text="{TemplateBinding Subtitle}"
                         FontSize="11.5"
                         Foreground="{DynamicResource TextSecondary}"
                         TextWrapping="Wrap"
                         Margin="0,2,0,0" />
            </StackPanel>
            <ContentPresenter Grid.Column="2"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right" />
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Subtitle, RelativeSource={RelativeSource TemplatedParent}}" Value="">
              <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}" Value="">
              <Setter TargetName="IconBox" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="7"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{DynamicResource HoverBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{DynamicResource PressedBackground}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="Tag" Value="Selected" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentHover}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsPressed" Value="True" />
                <Condition Property="Tag" Value="Selected" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentHover}" />
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}" />

  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="7"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ToggleSwitch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="42" Height="24" Background="Transparent">
            <Border x:Name="Track"
                    Width="42"
                    Height="24"
                    CornerRadius="12"
                    Background="{DynamicResource TrackBackground}" />
            <Ellipse x:Name="Knob"
                     Width="18"
                     Height="18"
                     Fill="{DynamicResource ToggleKnob}"
                     HorizontalAlignment="Left"
                     Margin="3,0,0,0">
              <Ellipse.Effect>
                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" Color="Black" />
              </Ellipse.Effect>
            </Ellipse>
            <Border x:Name="FocusRing"
                    CornerRadius="12"
                    BorderBrush="{DynamicResource Accent}"
                    BorderThickness="2"
                    Opacity="0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="5">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBackground}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBackground}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SettingsComboBox" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
    <Setter Property="MinWidth" Value="136" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Field"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7" />
            <ContentPresenter Margin="10,0,30,0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
            <Path Data="M 0 0 L 4 4 L 8 0"
                  Stroke="{DynamicResource TextSecondary}"
                  StrokeThickness="1.4"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="0,0,11,0" />
            <ToggleButton x:Name="DropDownButton"
                          Focusable="False"
                          Background="Transparent"
                          BorderThickness="0"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          ClickMode="Press">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent" />
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Popup x:Name="PART_Popup"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   AllowsTransparency="True"
                   Placement="Bottom"
                   Focusable="False"
                   PopupAnimation="Fade">
              <Border Background="{DynamicResource ControlBackground}"
                      BorderBrush="{DynamicResource ControlBorder}"
                      BorderThickness="1"
                      CornerRadius="9"
                      Margin="0,4,0,0"
                      Padding="4"
                      MinWidth="160"
                      MaxHeight="320">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SliderDecreaseButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="{DynamicResource Accent}" CornerRadius="6" Height="12" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SliderIncreaseButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" Height="12" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SliderThumb" TargetType="Thumb">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid>
            <Ellipse Fill="White" Stroke="#22000000" StrokeThickness="1" />
            <Ellipse Fill="Transparent" Stroke="{DynamicResource Accent}" StrokeThickness="2" Opacity="0" x:Name="Focus" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Focus" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ThickSlider" TargetType="Slider">
    <Setter Property="Height" Value="24" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="24" Background="Transparent">
            <Border Height="12"
                    CornerRadius="6"
                    VerticalAlignment="Center"
                    Background="{DynamicResource TrackBackground}" />
            <Track x:Name="PART_Track" VerticalAlignment="Center">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderDecreaseButton}" Command="{x:Static Slider.DecreaseLarge}" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource SliderIncreaseButton}" Command="{x:Static Slider.IncreaseLarge}" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource SliderThumb}" />
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type controls:ShapeCard}">
    <Setter Property="GroupName" Value="ShapeChoice" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:ShapeCard}">
          <StackPanel Background="Transparent">
            <Grid>
              <Border x:Name="Preview"
                      Height="110"
                      CornerRadius="16"
                      Background="{DynamicResource PreviewBackdrop}">
                <controls:ShapeThumbnail x:Name="Thumb"
                                         Width="92"
                                         Height="92"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Shape="{TemplateBinding Shape}"
                                         Blob="{TemplateBinding Blob}"
                                         CornerRadius="{TemplateBinding CornerRadiusValue}" />
              </Border>
              <!-- Draws on top of the tile like SwiftUI's strokeBorder, so selection never shrinks the preview. -->
              <Border x:Name="Ring"
                      CornerRadius="16"
                      BorderBrush="#14FFFFFF"
                      BorderThickness="1" />
              <!-- Selection ring floats just outside the tile, like the macOS reference. -->
              <Border x:Name="SelectionRing"
                      Margin="-4"
                      CornerRadius="20"
                      BorderBrush="{DynamicResource Selection}"
                      BorderThickness="3"
                      Visibility="Hidden" />
            </Grid>
            <TextBlock x:Name="Caption"
                       Text="{TemplateBinding Label}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource TextSecondary}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="BorderBrush" Value="#40FFFFFF" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible" />
              <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource TextPrimary}" />
              <Setter TargetName="Caption" Property="FontWeight" Value="Bold" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type controls:BlobChip}">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:BlobChip}">
          <StackPanel Background="Transparent">
            <Grid Width="56" Height="56">
              <Border x:Name="Box"
                      CornerRadius="10"
                      Background="{DynamicResource BlobTileFill}">
                <Grid>
                  <controls:BlobGlyph x:Name="BlobGlyph"
                                      Width="38"
                                      Height="38"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      FillBrush="{DynamicResource AccentShape}"
                                      Blob="{TemplateBinding Blob}" />
                  <TextBlock x:Name="ShuffleGlyph"
                             Text="&#xE8B1;"
                             FontFamily="{DynamicResource IconFont}"
                             FontSize="18"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentShape}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Visibility="Collapsed" />
                </Grid>
              </Border>
              <Border x:Name="Ring"
                      CornerRadius="10"
                      BorderBrush="{DynamicResource Selection}"
                      BorderThickness="2"
                      Visibility="Hidden" />
            </Grid>
            <TextBlock x:Name="Caption"
                       Text="{TemplateBinding Label}"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"
                       Foreground="{DynamicResource TextSecondary}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
              <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource TextPrimary}" />
              <Setter TargetName="Caption" Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type controls:ColorPickerButton}">
    <Setter Property="Width" Value="58" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:ColorPickerButton}">
          <Border x:Name="Swatch"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource ControlBorder}"
                  BorderThickness="1"
                  CornerRadius="7">
            <Border Margin="3"
                    Background="{TemplateBinding Background}"
                    CornerRadius="5" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Swatch" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Swatch" Property="BorderBrush" Value="{DynamicResource Accent}" />
              <Setter TargetName="Swatch" Property="BorderThickness" Value="2" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
  </Style>
</ResourceDictionary>
